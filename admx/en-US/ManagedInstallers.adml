<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="4.0" schemaVersion="1.0">
  <displayName>Managed Installers</displayName>
  <description>Configuration for controlled Windows Managed Installer rules.</description>
  <resources>
    <stringTable>
      <string id="SUPPORTED_Windows10">Windows 10 and later</string>
      <string id="Category_ManagedInstallers">Managed Installers</string>
      <string id="Rule_Help">Enter publisher information exactly as shown in the digital signature. The examples below are fictional and must be replaced. Paths, wildcards, and selected high-risk generic executables are rejected. Minimum versions require four numeric parts; use 0.0.0.0 only when all matching signed versions should be allowed.</string>
      <string id="Rule01">Managed Installer 01</string><string id="Rule02">Managed Installer 02</string><string id="Rule03">Managed Installer 03</string><string id="Rule04">Managed Installer 04</string><string id="Rule05">Managed Installer 05</string>
      <string id="Rule06">Managed Installer 06</string><string id="Rule07">Managed Installer 07</string><string id="Rule08">Managed Installer 08</string><string id="Rule09">Managed Installer 09</string><string id="Rule10">Managed Installer 10</string>
      <string id="Rule11">Managed Installer 11</string><string id="Rule12">Managed Installer 12</string><string id="Rule13">Managed Installer 13</string><string id="Rule14">Managed Installer 14</string><string id="Rule15">Managed Installer 15</string>
      <string id="Rule16">Managed Installer 16</string><string id="Rule17">Managed Installer 17</string><string id="Rule18">Managed Installer 18</string><string id="Rule19">Managed Installer 19</string><string id="Rule20">Managed Installer 20</string>
    </stringTable>
    <presentationTable>
      <presentation id="RuleOptions"><textBox refId="Name"><label>Display name (example: Example Software Agent)</label></textBox><textBox refId="Publisher"><label>Publisher name (example: O=EXAMPLE ORGANIZATION, L=EXAMPLE CITY, C=US)</label></textBox><textBox refId="Product"><label>Product name (example: EXAMPLE SOFTWARE AGENT)</label></textBox><textBox refId="Binary"><label>Binary name (example: EXAMPLEAGENT.EXE)</label></textBox><textBox refId="MinimumVersion"><label>Minimum version (example: 1.0.0.0)</label></textBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
